# Firebase（クライアント）
# Firebase Console → プロジェクトの設定 → 全般 → マイアプリ（Web アプリ）の firebaseConfig から転記
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK（サーバー・API Routes 用）
# Firebase Console → プロジェクトの設定 → サービスアカウント → 新しい秘密鍵の生成（JSON）から転記
# ※ private_key は複数行のため、必ずダブルクォートで囲む（\n はそのまま）
#   例: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Claude API（https://platform.claude.com → API Keys。spend limit の設定も忘れずに）
ANTHROPIC_API_KEY=

# OpenAI API（Embeddings 用。https://platform.openai.com → API Keys）
OPENAI_API_KEY=

# ボット対策①：Firebase App Check（reCAPTCHA Enterprise）。手順は docs/SECURITY-SETUP.md
# Google Cloud Console → Security → reCAPTCHA で作った「ウェブサイト」キーの ID（公開してよい値）
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# 開発用のデバッグトークン（Firebase Console → App Check → デバッグトークンを管理）。"true" にするとブラウザのコンソールに新しい値が出る。本番では空のまま
NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=
# サーバー側の強制：off（既定・開発）／monitor（検証してログだけ。通す）／enforce（失敗は 401）
ENFORCE_APP_CHECK=off

# ボット対策②：IP レート制限（Upstash Redis の REST）。空ならプロセス内のメモリで数える（開発用）
# Upstash Console → Redis → データベース → REST API の値
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# true でレート制限を丸ごと止める（開発で邪魔なとき）
RATE_LIMIT_DISABLED=
